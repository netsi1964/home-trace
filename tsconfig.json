{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		// Scripts run with Node type stripping: no enums, namespaces or parameter properties.
		"erasableSyntaxOnly": true,
		"types": ["$app/types", "node"]
	},
	"include": ["src", "scripts", "vite.config.ts"],
	// The service worker has its own WebWorker types (SvelteKit: $app/tsconfig/service-worker).
	"exclude": ["src/service-worker.ts"]
}
