# Copy to .env (git-ignored) and fill in. Never commit real keys.

# OpenRouter key: used for JEV (typesafe/jev-1.14) and the vision-LLM detector.
OPEN_ROUTER_API_KEY=

# Optional: vision-LLM for Phase 0 discovery. Only verified families are accepted:
# qwen/qwen3-vl-* (bbox_2d, x1 y1 x2 y2, 0-1000) or google/gemini-* (box_2d, ymin xmin ymax xmax, 0-1000).
# Default: qwen/qwen3-vl-235b-a22b-instruct
VISION_MODEL=
