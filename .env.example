# Copy to .env (git-ignored) and fill in. Never commit real keys.

# OpenRouter key: used for JEV (typesafe/jev-1.14) and the vision-LLM detector.
OPEN_ROUTER_API_KEY=

# Optional: vision-LLM for Phase 0 discovery. Only verified families are accepted:
# qwen/qwen3-vl-* (bbox_2d, x1 y1 x2 y2, 0-1000) or google/gemini-* (box_2d, ymin xmin ymax xmax, 0-1000).
# Default: qwen/qwen3-vl-235b-a22b-instruct
VISION_MODEL=

# Private analysis proxy (PRD-SEC-007). Live AI stays off until all three are set.
# Invite code people type once in Data & settings (at least 8 characters).
HOMETRACE_ACCESS_CODE=
# Random secret for signing the access cookie (at least 32 characters), e.g.: openssl rand -hex 32
HOMETRACE_SESSION_SECRET=
# Optional: jev | vision | vision-jev (default vision-jev)
HOMETRACE_PROVIDER=
# Optional: provider requests allowed per UTC day across all users (default 200)
HOMETRACE_DAILY_REQUEST_LIMIT=
